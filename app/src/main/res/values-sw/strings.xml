    <string name="string_legal_use">1. Matumizi halali</string>
    <string name="string_content_legal_use">Programu hii imekusudiwa kupakua maudhui unayomiliki au uliyo na ruhusa ya kuyapakua. Hatuwajibiki kwa ukiukaji wowote wa hakimiliki unaoweza kutokea unapotumia programu hii. Kwa masuala ya hakimiliki, tafadhali wasiliana na mtayarishaji wa maudhui.</string>
    <string name="string_no_liability">2. Hakuna dhima</string>
    <string name="string_content_no_liability">Hatuwajibiki kwa uharibifu wowote unaoweza kutokana na matumizi ya programu hii, ikijumuisha lakini si tu kupotea kwa data au kukatika kwa huduma.</string>
    <string name="string_data_security">3. Usalama wa data</string>
    <string name="string_content_data_security">Tumejitolea kulinda taarifa zako binafsi. Hata hivyo, hatushauri kupakua maudhui kutoka vyanzo visivyoaminika.</string>
    <string name="string_limitation_of_liability">4. Ukomo wa dhima</string>
    <string name="string_content_limitation_of_liability">Programu hii haihakikishi kuwa maudhui yote yaliyopakuliwa yatapatikana kila wakati au hayatakuwa na hitilafu. Upakuaji ni kwa hatari ya mtumiaji mwenyewe.</string>
    <string name="string_terms_of_service">5. Masharti ya huduma</string>
    <string name="string_content_terms_of_service">Kwa kutumia programu hii, unakubali masharti yetu ya huduma na sera ya faragha. Tafadhali yasome kwa makini.</string>
