<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background Circle -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#FFE5D9" />
            <size
                android:width="120dp"
                android:height="120dp" />
        </shape>
    </item>

    <!-- Language Icon A -->
    <item
        android:bottom="40dp"
        android:left="20dp"
        android:right="50dp"
        android:top="20dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFA726" />
            <corners android:radius="8dp" />
        </shape>
    </item>

    <!-- Language Icon Text A -->
    <item
        android:bottom="50dp"
        android:left="30dp"
        android:right="60dp"
        android:top="30dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
        </shape>
    </item>

    <!-- Language Icon B -->
    <item
        android:bottom="20dp"
        android:left="50dp"
        android:right="20dp"
        android:top="40dp">
        <shape android:shape="rectangle">
            <solid android:color="#EF5350" />
            <corners android:radius="8dp" />
        </shape>
    </item>

    <!-- Language Icon Text B -->
    <item
        android:bottom="30dp"
        android:left="60dp"
        android:right="30dp"
        android:top="50dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
</layer-list>

