    <string name="string_legal_use">1. Sử dụng hợp pháp</string>
    <string name="string_content_legal_use">Ứng dụng này được thiết kế để tải xuống nội dung mà bạn sở hữu hoặc có quyền tải xuống. Chúng tôi không chịu trách nhiệm về bất kỳ vi phạm bản quyền nào có thể xảy ra trong quá trình sử dụng ứng dụng. Đối với các vấn đề bản quyền, vui lòng liên hệ với người tạo nội dung.</string>
    <string name="string_no_liability">2. Không chịu trách nhiệm</string>
    <string name="string_content_no_liability">Chúng tôi không chịu trách nhiệm về bất kỳ thiệt hại nào phát sinh từ việc sử dụng ứng dụng này, bao gồm nhưng không giới hạn ở việc mất dữ liệu hoặc gián đoạn dịch vụ.</string>
    <string name="string_data_security">3. Bảo mật dữ liệu</string>
    <string name="string_content_data_security">Chúng tôi cam kết bảo vệ thông tin cá nhân của bạn. Tuy nhiên, chúng tôi khuyên bạn không nên tải xuống nội dung từ các nguồn không đáng tin cậy.</string>
    <string name="string_limitation_of_liability">4. Giới hạn trách nhiệm</string>
    <string name="string_content_limitation_of_liability">Ứng dụng này không đảm bảo rằng tất cả nội dung đã tải xuống sẽ luôn khả dụng hoặc không có lỗi. Việc tải xuống hoàn toàn là rủi ro của người dùng.</string>
    <string name="string_terms_of_service">5. Điều khoản dịch vụ</string>
    <string name="string_content_terms_of_service">Bằng việc sử dụng ứng dụng này, bạn đồng ý với điều khoản dịch vụ và chính sách bảo mật của chúng tôi. Vui lòng đọc kỹ.</string>
