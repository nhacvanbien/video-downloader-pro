    <string name="string_legal_use">1. Legaal gebruik</string>
    <string name="string_content_legal_use">Deze app is bedoeld voor het downloaden van content die je bezit of waarvoor je toestemming hebt om te downloaden. Wij zijn niet verantwoordelijk voor eventuele auteursrechtschendingen die tijdens het gebruik van de app kunnen optreden. Neem bij auteursrechtkwesties contact op met de maker van de content.</string>
    <string name="string_no_liability">2. Geen aansprakelijkheid</string>
    <string name="string_content_no_liability">Wij zijn niet aansprakelijk voor schade die voortvloeit uit het gebruik van deze app, met inbegrip van maar niet beperkt tot gegevensverlies of serviceonderbrekingen.</string>
    <string name="string_data_security">3. Gegevensbeveiliging</string>
    <string name="string_content_data_security">Wij zetten ons in om je persoonlijke gegevens te beschermen. We raden je echter af om content van onbetrouwbare bronnen te downloaden.</string>
    <string name="string_limitation_of_liability">4. Beperking van aansprakelijkheid</string>
    <string name="string_content_limitation_of_liability">Deze app garandeert niet dat alle gedownloade content altijd beschikbaar of foutvrij is. Downloaden gebeurt volledig op eigen risico van de gebruiker.</string>
    <string name="string_terms_of_service">5. Servicevoorwaarden</string>
    <string name="string_content_terms_of_service">Door deze app te gebruiken ga je akkoord met onze servicevoorwaarden en ons privacybeleid. Lees ze zorgvuldig door.</string>
