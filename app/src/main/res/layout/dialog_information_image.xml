<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_16sdp"
        android:background="@drawable/bg_dialog_rate"
        android:orientation="vertical"
        android:paddingVertical="@dimen/_15sdp">

        <LinearLayout
            android:id="@+id/native_ads"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/button_close"
            app:srcCompat="@drawable/ic_close"
            android:layout_gravity="end"
            android:layout_marginEnd="@dimen/_12sdp"
            android:padding="@dimen/_4sdp"
            android:tint="#5B5D5F"
            android:layout_width="@dimen/_24sdp"
            android:layout_height="@dimen/_24sdp" />

        <androidx.appcompat.widget.AppCompatImageView
            android:src="@drawable/ic_download_image"
            android:layout_gravity="center_horizontal"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_link"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="marquee"
            android:layout_marginTop="@dimen/_8sdp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:fontFamily="@font/sf_pro_display_medium"
            android:gravity="center"
            android:lines="2"
            android:marqueeRepeatLimit="marquee_forever"
            android:maxLines="2"
            android:paddingHorizontal="@dimen/_8sdp"
            android:scrollHorizontally="true"
            android:text="@string/string_your_download_is_complete_you_can_now_access_your_file"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/_16ssp" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_download_image"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_32sdp"
            android:layout_marginHorizontal="@dimen/_32sdp"
            android:background="@drawable/bg_btn_skip_permission"
            android:fontFamily="@font/sf_pro_display_semi_bold"
            android:gravity="center"
            android:paddingVertical="@dimen/_12sdp"
            android:text="@string/string_download_image"
            android:textColor="@color/white"
            android:textSize="@dimen/_14sdp" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_open_new_tab"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:fontFamily="@font/sf_pro_display_semi_bold"
            android:gravity="center"
            android:paddingHorizontal="@dimen/_8sdp"
            android:text="@string/string_open_in_new_tab"
            android:textColor="@color/primary"
            android:textSize="@dimen/_14sdp" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_share"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:fontFamily="@font/sf_pro_display_semi_bold"
            android:gravity="center"
            android:paddingHorizontal="@dimen/_8sdp"
            android:text="@string/string_share"
            android:textColor="@color/primary"
            android:textSize="@dimen/_14sdp" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_copy_link"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:fontFamily="@font/sf_pro_display_semi_bold"
            android:gravity="center"
            android:paddingHorizontal="@dimen/_8sdp"
            android:text="@string/string_copy_link"
            android:textColor="@color/primary"
            android:textSize="@dimen/_14sdp" />

    </LinearLayout>
</LinearLayout>