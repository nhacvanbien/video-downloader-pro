    <string name="string_legal_use">1. Legální použití</string>
    <string name="string_content_legal_use">Tato aplikace je určena ke stahování obsahu, který vlastníte nebo ke kterému máte povolení. Neneseme odpovědnost za případná porušení autorských práv, ke kterým může při používání aplikace dojít. V otázkách autorských práv kontaktujte tvůrce obsahu.</string>
    <string name="string_no_liability">2. Žádná odpovědnost</string>
    <string name="string_content_no_liability">Neneseme odpovědnost za jakékoli škody, které mohou vzniknout používáním této aplikace, včetně, ale bez omezení na, ztrátu dat nebo výpadky služby.</string>
