    <string name="string_content_data_security">Zavazujeme se chránit vaše osobní údaje. Nedoporučujeme však stahovat obsah z nedůvěryhodných zdrojů.</string>
    <string name="string_limitation_of_liability">4. Omezení odpovědnosti</string>
    <string name="string_content_limitation_of_liability">Tato aplikace nezaručuje, že veškerý stažený obsah bude vždy dostupný nebo bez chyb. Stahování je zcela na vlastní riziko uživatele.</string>
    <string name="string_terms_of_service">5. Podmínky služby</string>
    <string name="string_content_terms_of_service">Používáním této aplikace souhlasíte s našimi podmínkami služby a zásadami ochrany osobních údajů. Pečlivě si je prosím přečtěte.</string>
